# Auth.js / NextAuth v5 + existing email/password JWT
# Generate: openssl rand -base64 32
AUTH_SECRET=

# App URL (local)
AUTH_URL=http://localhost:3000
# Alias still recognized by Auth.js:
# NEXTAUTH_URL=http://localhost:3000

# Extra origins allowed to call mutating email/password + progress APIs
# (Origin / Referer check in src/lib/auth/csrf.ts). Comma-separated.
# AUTH_URL / NEXTAUTH_URL are always included. In development, if this list
# and AUTH_URL are empty, localhost:3000 and 127.0.0.1:3000 are allowed.
#
# Local (optional — AUTH_URL already covers it):
# AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
#
# Production: your public https origin(s), including preview hosts:
# AUTH_TRUSTED_ORIGINS=https://your-app.fly.dev,https://your-custom-domain.com
AUTH_TRUSTED_ORIGINS=

# Google OAuth 2.0
# Console: https://console.cloud.google.com/apis/credentials
# Callback: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Microsoft Entra ID (Azure AD)
# Portal: https://entra.microsoft.com/ → App registrations
# Callback: http://localhost:3000/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# e.g. https://login.microsoftonline.com/<tenant-id>/v2.0
# or https://login.microsoftonline.com/common/v2.0 for multi-tenant
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# X (Twitter) OAuth 2.0
# Portal: https://developer.x.com/ → Project / App → Keys
# Callback: http://localhost:3000/api/auth/callback/twitter
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=

# Wave B1 — AI Local practice (pure client checklist). Default on when unset.
# Set to 0 to omit AI-runtime chrome on Prompt Engineering / AI-for-DE; Copy stays.
# NEXT_PUBLIC_AI_LAB=1
# No server proxy in v1. Do not set AI_PROXY_ENABLED or vendor keys.
